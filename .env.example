# ---- Runtime ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- MongoDB ----
# Connection string WITHOUT credentials committed to source control.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=logistics_eta
# Used by the automated test-suite. MUST end with "_test" (enforced) so cleanup can never touch real data.
MONGODB_DB_NAME_TEST=logistics_eta_test

# ---- Security ----
# Required for /api/admin/* endpoints (header: x-api-key). Minimum 16 characters.
ADMIN_API_KEY=change-me-to-a-long-random-string
REQUEST_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
ADMIN_RATE_LIMIT_MAX=20

# ---- Data generation / export ----
GENERATION_SEED=20261022
GENERATION_PROFILE=small
BATCH_SIZE=1000
EXPORT_DIR=exports
