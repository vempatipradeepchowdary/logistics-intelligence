{
  "name": "logistics-eta-intelligence",
  "version": "1.0.0",
  "description": "YottaFlex.ai Round 2 - Logistics intelligence & deterministic synthetic data engineering platform (Node.js, Express, MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "generate": "node src/scripts/generateData.js",
    "generate:small": "node src/scripts/generateData.js --profile small --reset",
    "generate:full": "node src/scripts/generateData.js --profile full --reset",
    "validate": "node src/scripts/validateData.js",
    "export": "node src/scripts/exportData.js",
    "verify:repro": "node src/scripts/verifyReproducibility.js",
    "docs:dictionary": "node src/scripts/generateDataDictionary.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:acceptance": "vitest run tests/acceptance",
    "test:full": "vitest run --config vitest.full.config.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend test",
    "frontend:e2e": "npm --prefix frontend run test:e2e",
    "frontend:lint": "npm --prefix frontend run lint"
  },
  "keywords": [
    "logistics",
    "eta",
    "synthetic-data",
    "mongodb",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
